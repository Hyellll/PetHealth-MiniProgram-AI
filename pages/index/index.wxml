<view class="page-home">
  <!-- 1. 顶部紫色页眉 -->
  <view class="custom-header">
    <view class="header-content">
      <view class="user-info">
        <text class="greeting">Hello, Parent</text>
        <text class="app-name">萌宠健康日记</text>
      </view>
      <view class="more-icon">•••</view>
    </view>
  </view>

  <scroll-view scroll-y class="main-content">
    <view class="section-title">我的毛孩子</view>
    
    <!-- 宠物卡片列表 -->
    <view class="pet-list">
      <view wx:for="{{petList}}" wx:key="index" class="pet-card-new" bindtap="goToDetail" bindlongpress="deletePet" data-name="{{item.name}}" data-index="{{index}}">
        <view class="pet-avatar-wrap">
          <text class="avatar-emoji">🐾</text>
        </view>
        <view class="pet-detail">
          <text class="pet-name">{{item.name}}</text>
          <text class="pet-status">守护中，点击进入记录</text>
        </view>
        <view class="arrow-right">></view>
      </view>
    </view>

    <!-- 暂无数据提示 -->
    <view wx:if="{{petList.length === 0}}" class="empty-state">
      <text class="empty-icon">🏠</text>
      <text>还没有添加毛孩子哦</text>
    </view>

    <view style="height: 200rpx;"></view> <!-- 留白 -->
  </scroll-view>

  <!-- 3. 悬浮添加按钮 (更现代的交互) -->
  <view class="fab-btn" bindtap="showAddPetModal">+</view>
</view>